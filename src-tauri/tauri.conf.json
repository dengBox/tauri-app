{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-example",
  "version": "0.1.0",
  "identifier": "com.tauri-example.app",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm serve",
    "devUrl": "http://localhost:2999",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tauri App",
        "url": "",
        "width": 1000,
        "height": 600,
        "fullscreen": false,
        "resizable": true,
        "x": 0,
        "y": 0
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}